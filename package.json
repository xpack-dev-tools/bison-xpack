      "baseUrl": "https://github.com/xpack-dev-tools/bison-xpack/releases/download/v3.8.2-1",
      "skip": 1,
      "platforms": {
        "darwin-arm64": {
          "fileName": "xpack-bison-3.8.2-1-darwin-arm64.tar.gz",
