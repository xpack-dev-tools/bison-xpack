        },
        "linux-arm64": {
          "fileName": "xpack-bison-3.8.2-1-linux-arm64.tar.gz",
          "sha256": "907ff696b73a01d1224ac193c9e1a966bf53336eb3e7bc7dee459ea9e086284f"
        },
        "linux-x64": {
          "fileName": "xpack-bison-3.8.2-1-linux-x64.tar.gz",
